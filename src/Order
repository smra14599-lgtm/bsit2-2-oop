import java.util.ArrayList;

class Order {
    private String customer;
    private ArrayList<Item> list;

    public Order(String customer) {
        this.customer = customer;
        this.list = new ArrayList<>();
    }

    public void insert(String itemName, double itemPrice) {
        if (itemName == null || itemName.trim().isEmpty()) {
            System.out.println("Error: Invalid item: cannot be empty");
            return;
        }
        if (itemPrice <= 0) {
            System.out.println("Error: Invalid price: must be greater than 0");
            return;
        }
        list.add(new Item(itemName, itemPrice));
        if (itemName.equals("Pizza")) {
            System.out.println("Item 'Pizza' added successfully");
        }
    }

    public String getCustomer() {
        return customer;
    }

    public int countItems() {
        return list.size();
    }

    public double totalPrice() {
        double sum = 0;
        for (Item i : list) {
            sum += i.price();
        }
        return sum;
    }

    public String orderSize() {
        int c = countItems();
        if (c <= 3) return "Small";
        if (c <= 5) return "Medium";
        return "Large";
    }

    public String toString() {
        return "Order for " + customer + ": " + countItems() +
                " items, Total: $" + String.format("%.2f", totalPrice()) +
                ", Size: " + orderSize();
    }
}

class Item {
    private String name;
    private double price;

    public Item(String n, double p) {
        this.name = n;
        this.price = p;
    }

    public double price() {
        return price;
    }
}
